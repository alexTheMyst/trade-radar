FINNHUB_API_KEY=
HEALTHCHECKS_UUID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=

# Required: pinned Claude model ID (no floating aliases)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: path to thesis.yaml (default: thesis.yaml at repo root)
# THESIS_PATH=thesis.yaml

# Optional: backup destination (default: state/backups, gitignored). Relative
# paths are anchored at the repo root, so Task Scheduler's cwd doesn't matter.
# BACKUP_DIR=state/backups

# Optional: per-job healthchecks.io checks. Each scheduled job pings its own
# check when the matching variable is set; otherwise it falls back to the
# shared HEALTHCHECKS_UUID above. ROLLOUT ORDER: create the check in
# healthchecks.io FIRST, then set the env var — pings to a nonexistent check
# 404 silently and the shared check would go quiet.
# HEALTHCHECKS_UUID_DAILY_CLOSE=
# HEALTHCHECKS_UUID_NEWS_MORNING=
# HEALTHCHECKS_UUID_DISCOVERY=
# HEALTHCHECKS_UUID_OUTCOME_BACKFILL=
# HEALTHCHECKS_UUID_REVIEW_REPORT=
# HEALTHCHECKS_UUID_WEEKLY_SYNTHESIS=
# HEALTHCHECKS_UUID_SENTINEL=
# HEALTHCHECKS_UUID_BACKUP=
# HEALTHCHECKS_UUID_WATCHDOG=
# HEALTHCHECKS_UUID_DISPATCH=
# HEALTHCHECKS_UUID_TELEGRAM_POLL=

# Optional: Discovery mode (Plan 12d). "shadow" (default) logs and measures
# every signal but never delivers it. "compete" lets Discovery compete for
# INFORMATIONAL slots at last priority; its ACTION_REQUIRED lane stays 0 in
# both modes. Re-enable INFO delivery at quarterly review.
# DISCOVERY_MODE=shadow
